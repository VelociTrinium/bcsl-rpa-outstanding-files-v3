# ============================================================================================
# BCSL Outstanding-Emailer Configuration
# ============================================================================================

# Which job(s) to run by default. Valid options: 'client' (emails outstanding invoice lists to clients), 'sales' (emails consolidated outstanding client lists to sales managers), 'both' (runs both client and sales jobs sequentially)
RUN_JOBS=both

# Time delay (in seconds) to pause between sending each email. Helps avoid spam filters or rate limiting. Options: any number (e.g. 0 to disable, 2.5, 5, etc.)
EMAIL_DELAY_SECONDS=60.0

# Name of the Tally outstanding Excel report file. Must reside in the same directory as the executable
REPORT_FILE=Client_OS_Report.xlsx

# Delivery transport mode. Valid options: 'dry_run' (generates draft HTML/EML previews locally under output folder), 'smtp' (sends emails directly using SMTP server configuration), 'outlook' (sends emails via local Windows Outlook desktop application using your signed-in account)
TRANSPORT=dry_run

# Whether to only send emails to entries marked 'Y' or 'y' in the 'Send Email (Y/N)' column. Valid options: True, False
SEND_ONLY_WHEN_FLAG_Y=True



# ============================================================================================
# SMTP server host address (e.g. smtp.gmail.com or smtp.office365.com)
SMTP_HOST=smtp.gmail.com

# SMTP server port number (e.g., 587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# SMTP connection security protocol. Valid options: 'starttls', 'ssl', 'none'
SMTP_SECURITY=starttls

# Username credential for the SMTP login (e.g. your email address)
SMTP_USERNAME=jay.mvbom.plays@gmail.com

# Password or App Password credential for SMTP login. For Gmail or Office 365, generate a 16-character App Password
# for Gmail go to - https://myaccount.google.com/apppasswords, create a new app name and copy paste the password here.
SMTP_PASSWORD=sbbu olzi xvcp ktjd
# ============================================================================================



# Company's official name used in signatures
COMPANY_NAME=Benchmark Computer Solutions Limited

# Company's physical address. Must be a JSON array of strings, e.g. ["Line 1", "Line 2"]
COMPANY_ADDR=["501, 5th Floor, Kushwah Chambers, Makhawana Road,", "Marol Naka, Andheri East, Mumbai - 400059"]

# Company ISO or certification text line in signatures
COMPANY_CERT=ISO 9001:2015 CERTIFIED

# Social media links. Format: a JSON array of lists, each containing ["icon_filename.png", "profile_url"]
SOCIAL_LINKS=[["image002.png", "https://www.facebook.com/benchmarkcomputersolutions/"], ["image003.png", "https://www.linkedin.com/company/benchmarkcomputersolutions/"], ["image004.png", "https://twitter.com/BCSPLMumbai"], ["image005.png", "https://www.instagram.com/benchmarkcomputersolutions/"]]

# Name of the company logo image file in the assets folder
LOGO_FILE=image001.png




# ============================================================================================

# Whether to show color-coded overdue summary bars at the top of client emails. Valid options: True, False
SHOW_OVERDUE_BARS=True

# Name of the Excel address book spreadsheet containing client email addresses
CLIENT_ADDRESS_FILE=bcsl-client-outstanding-email-addresses.xlsx

# Display name in the 'From' field for client outstanding emails
CLIENT_FROM_NAME=Accounts - Benchmark Computer Solutions

# Email address in the 'From' field for client outstanding emails
CLIENT_FROM_EMAIL=accounts@benchmarksolution.com

# Subject line template for client outstanding emails. '{name}' placeholder is replaced with client name
CLIENT_SUBJECT=Outstanding - {name}

# Age threshold (days) for client overdue splitting. Bills older fall under OVER_30 (overdue), newer fall under UPTO_30 (recent/unconfirmed)
CLIENT_THRESHOLD_DAYS=30

# Greeting text at the start of client emails (e.g. Dear Sir/Mam,)
CLIENT_GREETING=Dear Sir/Mam,

# Introduction line header above the table for invoices strictly older than CLIENT_THRESHOLD_DAYS
CLIENT_INTRO_OVER_30=Please Update Payment Status,

# Introduction line header above the table for invoices newer/equal to CLIENT_THRESHOLD_DAYS
CLIENT_INTRO_UPTO_30=Please confirm below invoice with your account.,

# Contact details for client email signer. Must be a JSON dictionary containing 'name', 'title', 'direct', and 'main' keys
CLIENT_SIGNER={"name": "Dipesh Thakur", "title": "Accounts Executive", "direct": "+91 (022) 40822105", "main": "+91 (022) 40822100"}




# ============================================================================================

# Name of the Excel address book spreadsheet containing sales person email addresses
SALES_ADDRESS_FILE=bcsl-salesteam-email-addresses.xlsx

# Display name in the 'From' field for sales consolidated emails
SALES_FROM_NAME=Mohit P - Benchmark Computer Solutions

# Email address in the 'From' field for sales consolidated emails
SALES_FROM_EMAIL=mohit.p@benchmarksolution.com

# Subject line text for sales consolidated emails
SALES_SUBJECT=Outstanding Bills more than 35 days

# Invoice age threshold (days) for sales consolidated reports. Only groups invoices strictly older than this threshold
SALES_THRESHOLD_DAYS=35

# Greeting text at the start of sales salesperson emails (e.g. Dear Sir,)
SALES_GREETING=Dear Sir,

# Introduction line for salesperson consolidated emails explaining the attached outstanding list
SALES_INTRO=Please find below outstanding bills above 35 days. Please revert with updated status and expected payment dates.

# Contact details for sales email signer. Must be a JSON dictionary containing 'name', 'title', 'direct', and 'main' keys
SALES_SIGNER={"name": "Mohit Pusalkar", "title": "Manager-Accounts & Compliance", "direct": "+91-22-40822122", "main": "+91 (022) 40822100"}




# No need to change bellow -
# ============================================================================================

# Directory name where program outputs (previews, manifests, log file) are stored (default: outstanding_emails_output)
OUTPUT_DIR=outstanding_emails_output

# Directory name where images and logos are stored (default: assets)
ASSETS_DIR=assets

# Whether to allow fuzzy name matching between Tally reports and address books. Valid options: True, False
ALLOW_FUZZY_MATCH=False

# Cut-off threshold score for fuzzy matching. Value between 0.0 (match anything) and 1.0 (exact match)
FUZZY_CUTOFF=0.92